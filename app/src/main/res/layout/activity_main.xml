<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Google Maps Navigation Cue Detector"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prototype: observes visible Google Maps accessibility text only. It makes no network requests and does not send data anywhere."
            android:textSize="15sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Accessibility Settings" />

        <Button
            android:id="@+id/clearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Detected Cues" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accessibility service: OFF"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
